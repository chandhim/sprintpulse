{
  "manifest_version": 3,
  "name": "SprintPulse",
  "version": "1.2.0",
  "minimum_chrome_version": "114",
  "description": "One-click, evidence-based Red/Amber/Green sprint status reports from your Jira or Trello board, in a side panel you can hide any time.",
  "action": {
    "default_title": "Open SprintPulse side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["https://*.atlassian.net/*", "https://trello.com/*"]
}
